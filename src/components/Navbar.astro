---
import { Icon } from 'astro-icon/components';
import { navLinks } from '@/data/navigation';
import { profile } from '@/data/profile';
---

<header
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 ease-[var(--ease-reveal)] [&[data-on-stage]_.nav-brand]:text-white [&[data-on-stage]_.nav-jp]:text-accent [&[data-on-stage]_.nav-link]:text-white/70 [&[data-on-stage]_.nav-link:hover]:text-white [&[data-on-stage]_.nav-link[data-active]]:text-accent [&[data-on-stage]_.nav-toggle]:border-white/25 [&[data-on-stage]_.nav-toggle]:text-white"
  data-navbar
>
  <nav
    class="u-container flex h-[72px] items-center justify-between"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="group flex items-baseline gap-2.5 text-ink"
      data-scroll-link
    >
      <span class="nav-brand text-base font-extrabold tracking-tight transition-colors duration-500">{profile.nameEn}</span>
      <span class="nav-jp u-jp text-sm text-rose-gold transition-colors duration-500">{profile.nameJp}</span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={`#${link.id}`}
              class="nav-link relative rounded-full px-3.5 py-2 text-sm font-medium text-ink-soft transition-colors duration-300 hover:text-ink data-[active]:text-accent-deep"
              data-scroll-link
              data-nav-link={link.id}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      class="nav-toggle flex h-11 w-11 items-center justify-center rounded-full border border-rose-gold-soft/30 text-ink transition-colors duration-300 hover:bg-white/70 lg:hidden"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <Icon name="lucide:menu" class="h-5 w-5" data-menu-icon-open />
      <Icon name="lucide:x" class="hidden h-5 w-5" data-menu-icon-close />
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-40 opacity-0 transition-opacity duration-400 ease-[var(--ease-reveal)] lg:hidden"
  data-mobile-menu
  hidden
>
  <div class="absolute inset-0 bg-bg/85 backdrop-blur-2xl"></div>
  <nav
    class="u-container relative flex h-full flex-col justify-center"
    aria-label="Mobile"
  >
    <ul class="flex flex-col gap-1">
      {
        navLinks.map((link, index) => (
          <li
            class="translate-y-4 opacity-0 transition-all duration-500 ease-[var(--ease-reveal)]"
            style={`transition-delay:${index * 45}ms`}
            data-menu-item
          >
            <a
              href={`#${link.id}`}
              class="block py-3 text-3xl font-light text-ink transition-colors duration-300 hover:text-accent-deep"
              data-scroll-link
              data-menu-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="u-rule mt-10" aria-hidden="true"></div>
    <p class="u-jp mt-6 text-sm text-rose-gold">{profile.nameJp} · {profile.unit}</p>
  </nav>
</div>

<script>
  import { scrollToId } from '@/scripts/lenis-setup';

  const navbar = document.querySelector<HTMLElement>('[data-navbar]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const iconOpen = document.querySelector<HTMLElement>('[data-menu-icon-open]');
  const iconClose = document.querySelector<HTMLElement>('[data-menu-icon-close]');
  const menuItems = document.querySelectorAll<HTMLElement>('[data-menu-item]');

  // Frosted chrome only once the hero has started scrolling away, and a tone
  // flip whenever a dark stage section is the thing sitting under the bar.
  if (navbar) {
    const stageSections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-tone="stage"]'),
    );

    const canBlur = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    const applyChrome = () => {
      const scrolled = window.scrollY > 24;
      const probe = 36; // just inside the bar's own height
      const onStage = stageSections.some((section) => {
        const { top, bottom } = section.getBoundingClientRect();
        return top <= probe && bottom >= probe;
      });

      // Fixed and visible during every scroll frame — the most expensive possible
      // place for a backdrop blur, so touch devices get opacity instead.
      navbar.classList.toggle('backdrop-blur-xl', scrolled && canBlur);
      navbar.classList.toggle(canBlur ? 'bg-bg/70' : 'bg-bg/95', scrolled && !onStage);
      navbar.classList.toggle('shadow-[0_1px_0_0_rgba(183,110,121,0.12)]', scrolled && !onStage);
      navbar.classList.toggle(canBlur ? 'bg-night/75' : 'bg-night/95', scrolled && onStage);
      navbar.toggleAttribute('data-on-stage', onStage);
    };

    window.addEventListener('scroll', applyChrome, { passive: true });
    window.addEventListener('resize', applyChrome, { passive: true });
    applyChrome();
  }

  let menuOpen = false;

  function setMenu(open: boolean): void {
    if (!menu || !toggle) return;
    menuOpen = open;

    if (open) menu.hidden = false;

    requestAnimationFrame(() => {
      menu.classList.toggle('opacity-0', !open);
      menu.classList.toggle('pointer-events-none', !open);
      menuItems.forEach((item) => {
        item.classList.toggle('opacity-0', !open);
        item.classList.toggle('translate-y-4', !open);
      });
    });

    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';

    if (!open) {
      window.setTimeout(() => {
        if (!menuOpen) menu.hidden = true;
      }, 400);
    }
  }

  toggle?.addEventListener('click', () => setMenu(!menuOpen));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuOpen) {
      setMenu(false);
      toggle?.focus();
    }
  });

  // Smooth-scroll every in-page anchor through Lenis, and close the menu first.
  document.querySelectorAll<HTMLAnchorElement>('[data-scroll-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.getAttribute('href')?.slice(1);
      if (!id) return;
      event.preventDefault();
      if (menuOpen) setMenu(false);
      scrollToId(id);
      history.replaceState(null, '', `#${id}`);
    });
  });

  // Active-section highlighting in the desktop nav.
  const navLinkEls = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const sections = Array.from(navLinkEls)
    .map((el) => document.getElementById(el.dataset.navLink ?? ''))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinkEls.forEach((el) => {
            el.toggleAttribute('data-active', el.dataset.navLink === entry.target.id);
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>
