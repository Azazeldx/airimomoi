---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { costumes } from '@/data/costumes';
---

<div class="u-reveal-init relative mt-16" data-reveal>
  <div class="swiper !overflow-visible" data-costume-swiper>
    <div class="swiper-wrapper">
      {
        costumes.map((costume) => (
          <div class="swiper-slide !h-auto">
            <figure class="u-glass group h-full overflow-hidden p-0">
              <div class="relative overflow-hidden">
                <Image
                  src={costume.image}
                  alt={costume.alt}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 1440px) 33vw, (min-width: 1024px) 42vw, (min-width: 640px) 62vw, 92vw"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] w-full bg-primary/15 object-cover transition-transform duration-[1100ms] ease-[var(--ease-reveal)] group-hover:scale-105"
                />
                <span class="absolute left-5 top-5 flex items-center gap-2 rounded-full bg-white/90 px-3 py-1.5 text-[11px] font-semibold tracking-wide text-ink backdrop-blur-sm">
                  <span
                    class="h-2 w-2 rounded-full"
                    style={`background:${costume.accent}`}
                    aria-hidden="true"
                  />
                  {costume.subtitle}
                </span>
              </div>
              <figcaption class="p-7">
                <h3 class="text-xl font-light text-ink">{costume.name}</h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-soft">{costume.description}</p>
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-10 flex items-center justify-between gap-6">
    <div
      class="h-px flex-1 bg-rose-gold-soft/25 [&_.swiper-pagination-progressbar-fill]:bg-accent"
      data-costume-pagination
    >
    </div>
    <div class="flex gap-3">
      <button
        type="button"
        class="flex h-12 w-12 items-center justify-center rounded-full border border-rose-gold-soft/30 text-ink transition-all duration-300 hover:border-rose-gold hover:bg-white/70 disabled:opacity-35"
        aria-label="Previous costume"
        data-costume-prev
      >
        <Icon name="lucide:arrow-left" class="h-5 w-5" />
      </button>
      <button
        type="button"
        class="flex h-12 w-12 items-center justify-center rounded-full border border-rose-gold-soft/30 text-ink transition-all duration-300 hover:border-rose-gold hover:bg-white/70 disabled:opacity-35"
        aria-label="Next costume"
        data-costume-next
      >
        <Icon name="lucide:arrow-right" class="h-5 w-5" />
      </button>
    </div>
  </div>
</div>

<script>
  import Swiper from 'swiper';
  import { A11y, Keyboard, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  const el = document.querySelector<HTMLElement>('[data-costume-swiper]');

  if (el) {
    new Swiper(el, {
      modules: [Navigation, Pagination, Keyboard, A11y],
      slidesPerView: 1.08,
      spaceBetween: 20,
      grabCursor: true,
      breakpoints: {
        640: { slidesPerView: 1.6, spaceBetween: 24 },
        1024: { slidesPerView: 2.4, spaceBetween: 32 },
        1440: { slidesPerView: 3, spaceBetween: 36 },
      },
      navigation: {
        prevEl: '[data-costume-prev]',
        nextEl: '[data-costume-next]',
      },
      pagination: {
        el: '[data-costume-pagination]',
        type: 'progressbar',
      },
      keyboard: { enabled: true, onlyInViewport: true },
      a11y: {
        prevSlideMessage: 'Previous costume',
        nextSlideMessage: 'Next costume',
      },
    });
  }
</script>
