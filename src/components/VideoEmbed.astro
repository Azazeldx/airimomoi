---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { Track } from '@/data/music';

interface Props {
  track: Track;
}

const { track } = Astro.props;

// Facade pattern: only the poster loads until the user opts in, so six MVs cost
// six images instead of six YouTube iframes. Posters are bundled locally, so the
// page makes no third-party request until playback is requested.
const posters = import.meta.glob<{ default: ImageMetadata }>(
  '@/assets/images/music/*.jpg',
  { eager: true },
);
const poster = posters[`/src/assets/images/music/${track.videoId}.jpg`]!.default;
---

<article class="u-reveal-init group" data-reveal data-video-card>
  <button
    type="button"
    class="relative block w-full overflow-hidden rounded-[var(--radius-card)] shadow-[var(--shadow-glass)] transition-shadow duration-500 hover:shadow-[var(--shadow-lift)]"
    aria-label={`Play music video: ${track.titleEn} by ${track.performers}`}
    data-video-play
    data-video-id={track.videoId}
    data-video-title={track.titleEn}
  >
    <Image
      src={poster}
      alt=""
      widths={[400, 640, 900]}
      sizes="(min-width: 1280px) 30vw, (min-width: 768px) 46vw, 92vw"
      loading="lazy"
      decoding="async"
      class="aspect-video w-full bg-primary/20 object-cover transition-transform duration-[900ms] ease-[var(--ease-reveal)] group-hover:scale-[1.04]"
    />
    <span
      class="absolute inset-0 bg-gradient-to-t from-night/70 via-transparent to-transparent"
      aria-hidden="true"></span>
    <span
      class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-accent text-night shadow-[0_0_30px_-4px_rgba(255,125,175,0.9)] transition-transform duration-500 ease-[var(--ease-punch)] group-hover:scale-115"
      aria-hidden="true"
    >
      <Icon name="lucide:play" class="h-6 w-6 translate-x-0.5" />
    </span>
  </button>

  <div class="mt-5">
    <h3 class="text-xl font-extrabold tracking-[-0.02em] text-white">{track.titleEn}</h3>
    <p class="u-jp mt-1 text-sm tracking-[0.12em] text-white/55">{track.titleJp}</p>
    <p class="mt-2.5 text-xs font-extrabold uppercase tracking-[0.18em] text-accent">
      {track.performers}
    </p>
    <p class="mt-3 text-sm leading-relaxed text-white/60">{track.note}</p>
  </div>
</article>
