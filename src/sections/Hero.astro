---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Marquee from '@/components/Marquee.astro';
import PetalField from '@/components/PetalField.astro';
import { profile } from '@/data/profile';
import heroBackground from '@/assets/images/wallpapers/wl-background.png';
import heroCharacter from '@/assets/images/wallpapers/wl-character.png';
---

<section
  class="relative flex min-h-[100svh] items-center overflow-hidden"
  aria-labelledby="hero-title"
  data-hero
>
  <!-- Layer 1 — official wallpaper background, trailing the scroll. -->
  <div class="absolute inset-0" data-hero-bg>
    <Image
      src={heroBackground}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full scale-110 object-cover"
    />
    <!-- Just enough veil to hold text contrast; the pastel sky must stay readable. -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-bg/75 via-bg/25 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-bg to-transparent"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Layer 2 — soft colour bloom for depth between plate and subject. -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true" data-hero-bloom>
    <div
      class="u-glow u-bloom absolute -left-24 top-1/4 h-[28rem] w-[28rem]" style="--bloom:rgba(248,187,217,0.55)"
    >
    </div>
    <div
      class="u-glow u-bloom absolute -right-16 bottom-8 h-[32rem] w-[32rem]"
      style="--bloom:rgba(255,216,232,0.65);animation-duration:17s;animation-delay:-6s"
    >
    </div>
  </div>

  <!-- Layer 3 — character cutout, leading the scroll so she sits in front. -->
  <div
    class="pointer-events-none absolute inset-y-0 right-0 flex w-full items-end justify-end lg:w-[62%]"
    data-hero-character
  >
    <Image
      src={heroCharacter}
      alt={`${profile.nameEn} official illustration`}
      widths={[640, 900, 1200]}
      sizes="(min-width: 1024px) 58vw, 100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-auto w-full max-w-4xl origin-bottom translate-y-[14%] scale-[1.3] object-contain drop-shadow-[0_30px_60px_rgba(183,110,121,0.22)] sm:translate-y-0 sm:scale-100"
    />
  </div>

  <!-- Layer 4 — sakura drift, closest to the viewer. -->
  <PetalField class="z-[5]" />

  <div class="u-container relative z-10 pb-36 pt-32">
    <div class="max-w-2xl" data-hero-copy>
      <p
        class="u-eyebrow flex items-center gap-3 text-accent-deep"
        data-hero-line
      >
        <span class="h-px w-10 bg-accent-deep" aria-hidden="true"></span>
        Project SEKAI: Colorful Stage
      </p>

      <h1 id="hero-title" class="mt-6">
        <span class="u-display-xl block text-ink" aria-hidden="true" data-hero-title>
          {
            /* Split per word, then per character. The character spans drive
               the stagger; the word wrapper is what stops the name breaking
               mid-word, which loose inline-blocks otherwise do. */
            profile.nameEn.split(' ').map((word) => (
              <span class="mr-[0.24em] inline-block whitespace-nowrap last:mr-0">
                {[...word].map((char) => (
                  <span class="inline-block will-change-transform" data-hero-char>
                    {char}
                  </span>
                ))}
              </span>
            ))
          }
        </span>
        <span class="sr-only">{profile.nameEn}</span>
        <span
          class="u-jp mt-5 block text-[clamp(1.25rem,2.6vw,2rem)] tracking-[0.2em] text-rose-gold"
          data-hero-line
        >
          {profile.nameJp}
        </span>
      </h1>

      <p
        class="mt-8 max-w-md text-lg leading-relaxed font-medium text-ink sm:text-xl"
        data-hero-line
      >
        {profile.tagline}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4" data-hero-line>
        <Button href="#story">
          Discover her story
          <Icon name="lucide:arrow-down" class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" />
        </Button>
        <Button href="#unit" variant="ghost">
          Meet MORE MORE JUMP!
        </Button>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-28 left-1/2 z-10 hidden -translate-x-1/2 sm:block"
    aria-hidden="true"
    data-hero-scroll-cue
  >
    <div class="flex flex-col items-center gap-2 text-accent-deep">
      <span class="text-[10px] font-bold tracking-[0.3em] uppercase">Scroll</span>
      <span class="h-10 w-px bg-gradient-to-b from-accent-deep to-transparent"></span>
    </div>
  </div>

  <!-- Ticker band anchoring the hero, and the first hint of the stage tone. -->
  <div class="absolute inset-x-0 bottom-0 z-20">
    <Marquee
      items={[profile.nameEn, profile.nameJp, 'MORE MORE JUMP!', 'モアモアジャンプ！', 'Lovely Pink']}
      tone="accent"
      duration={34}
    />
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '@/scripts/gsap-setup';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const lines = gsap.utils.toArray<HTMLElement>('[data-hero-line]');
  const chars = gsap.utils.toArray<HTMLElement>('[data-hero-char]');
  const character = document.querySelector<HTMLElement>('[data-hero-character]');
  const bg = document.querySelector<HTMLElement>('[data-hero-bg]');
  const bloom = document.querySelector<HTMLElement>('[data-hero-bloom]');
  const copy = document.querySelector<HTMLElement>('[data-hero-copy]');
  const cue = document.querySelector<HTMLElement>('[data-hero-scroll-cue]');

  if (!reducedMotion && hero) {
    // Entrance: character rises into frame, the name punches in letter by
    // letter, copy follows behind her.
    const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });

    if (character) {
      // Transform-only: she is the LCP element, and fading her in from zero
      // opacity would push LCP out by the length of the fade.
      intro.from(character, { scale: 1.06, yPercent: 4, duration: 1.6 }, 0);
    }

    intro.from(
      chars,
      {
        yPercent: 115,
        rotate: 6,
        opacity: 0,
        duration: 0.95,
        ease: 'back.out(1.7)',
        stagger: 0.045,
      },
      0.15,
    );

    intro.from(lines, { opacity: 0, y: 34, duration: 1.1, stagger: 0.1 }, 0.5);

    if (cue) {
      intro.from(cue, { opacity: 0, y: -12, duration: 0.8 }, 1.2);
      gsap.to(cue, { y: 8, repeat: -1, yoyo: true, duration: 1.8, ease: 'sine.inOut' });
    }

    // The one pinned beat on the page: art holds, copy drifts up and dissolves.
    gsap
      .timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: '+=90%',
          scrub: 0.8,
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
        },
      })
      .to(copy, { yPercent: -38, opacity: 0, ease: 'power1.in' }, 0)
      .to(character, { yPercent: -8, scale: 1.05, ease: 'none' }, 0)
      .to(bg, { yPercent: 6, scale: 1.04, ease: 'none' }, 0)
      .to(bloom, { opacity: 0.45, ease: 'none' }, 0)
      .to(cue, { opacity: 0, duration: 0.15 }, 0);

    ScrollTrigger.refresh();
  }
</script>
