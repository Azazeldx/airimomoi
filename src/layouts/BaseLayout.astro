---
import '@fontsource-variable/inter';
// Noto Sans JP is declared directly in global.css as a hand-subset @font-face.
import '@/styles/global.css';

import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import ScrollProgress from '@/components/ui/ScrollProgress.astro';
import { getImage } from 'astro:assets';
import ogSource from '@/assets/images/wallpapers/wl-background.png';
import faviconSource from '@/assets/images/airi/airi-icon.png';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: ogSource, width: 1200, height: 630, format: 'jpeg' });
const favicon = await getImage({ src: faviconSource, width: 64, format: 'png' });
const ogImageUrl = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FFF9FC" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={favicon.src} type="image/png" />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a
      href="#about"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-ink focus:shadow-lg"
    >
      Skip to content
    </a>

    <ScrollProgress />
    <Navbar />

    <main id="top">
      <slot />
    </main>

    <Footer />

    <script>
      import { initSmoothScroll } from '@/scripts/lenis-setup';
      import { initReveals } from '@/scripts/reveal';
      import { initParallax, initPointerDepth } from '@/scripts/parallax';
      import { initAudioCards } from '@/scripts/audio';
      import { initVideoFacades } from '@/scripts/video';
      import { ScrollTrigger } from '@/scripts/gsap-setup';

      initSmoothScroll();
      initReveals();
      initParallax();
      initPointerDepth();
      initAudioCards();
      initVideoFacades();

      // Late-loading art changes page height; recompute trigger positions once settled.
      window.addEventListener('load', () => ScrollTrigger.refresh());
    </script>
  </body>
</html>
